# ASTITTVA MARKETING Invoice Management System - Backend Environment Configuration Template
# For Render Deployment: Add these in Render Dashboard -> Backend Service -> Environment

# MongoDB Connection (MongoDB Atlas)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/astittva_invoice_db?retryWrites=true&w=majority
DB_NAME=astittva_invoice_db

# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication Secret (Minimum 32 bytes)
JWT_SECRET=generate-a-secure-random-jwt-secret-for-production

# Cryptographic Integrity & Tamper-Proof Audit Secrets (Minimum 32 bytes / 64 hex characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_SIGNING_SECRET=your-secure-random-32-byte-hex-secret-for-audit-chain
INVOICE_SIGNING_SECRET=your-secure-random-32-byte-hex-secret-for-invoice-sealing

# Admin Credentials (Initial setup)
ADMIN_EMAIL=admin@astitva.com
ADMIN_PASSWORD=YourSecureAdminPassword2026
ADMIN_NAME=ASTITTVA Admin
